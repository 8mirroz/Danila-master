# PartsOps AI Manager — Environment Configuration
# Copy to .env and fill secrets. Never commit real .env.
# See: DM obs/05-reports/prod-env-checklist-2026-07-28.md

# ═══════════════════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════════════════
# dev | local | test | ci | production
PARTSOPS_ENV=dev
# Force seed on startup: 1/true | 0/false
# Unset: seeds only for sqlite/empty DATABASE_URL or explicit dev-like PARTSOPS_ENV
SEED_ON_START=1
TESTING=0
LOG_LEVEL=INFO
PARTSOPS_PHASE_LABEL=Phase 0 — Stabilization

# ═══════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════
# Local demo (default if unset):
# DATABASE_URL=sqlite:///./database.db
# Production:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/partsops
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ═══════════════════════════════════════════════════
# AUTH / TENANCY
# ═══════════════════════════════════════════════════
# Required in production (empty = open/dev mode)
PARTSOPS_API_TOKEN=
ENABLE_STRICT_TENANT_ENFORCEMENT=true
PARTSOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PARTSOPS_INTAKE_RATE_LIMIT=10
PARTSOPS_INTAKE_RATE_WINDOW=60

# ═══════════════════════════════════════════════════
# LLM PROVIDERS (chain; only one needed)
# ═══════════════════════════════════════════════════
# MOCK provider is auto-only when TESTING=1 — never use in prod.

# Primary: NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=google/gemma-4-31b-it

# Local: LM Studio
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=llama-3.1-8b-instruct
# LM_STUDIO_ENABLED=1

# Local: Ollama
# OLLAMA_ENABLED=1
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Cloud: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional proxy for LLM HTTP
# HTTPS_PROXY=
# HTTP_PROXY=

# ═══════════════════════════════════════════════════
# ERPNext (production: set URL + dry_run=0)
# ═══════════════════════════════════════════════════
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# 1 = no real ERP write (default if URL empty)
ERP_DRY_RUN=1
# Persistent HMAC secret for payment webhooks (required in prod)
ERP_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════
# DELIVERY (email / telegram)
# ═══════════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=

# ═══════════════════════════════════════════════════
# HERMES / COPILOT
# ═══════════════════════════════════════════════════
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
COPILOT_TIMEOUT_SECONDS=45
COPILOT_DAILY_BUDGET_USD=10.0
COPILOT_RPM_LIMIT=10
COPILOT_MAX_CONCURRENT_RUNS=2

# ═══════════════════════════════════════════════════
# UPLOADS / TEMPLATES
# ═══════════════════════════════════════════════════
MAX_UPLOAD_SIZE_MB=15
UPLOAD_ALLOWED_EXTENSIONS=pdf,xlsx,csv,jpg,jpeg,png
UPLOAD_DIR=08_DATA/uploads
ENABLE_STRICT_UPLOAD_VALIDATION=true
MAX_PARSE_ROWS=50000
# Optional absolute/relative path to contract export XLSX template
# PARTSOPS_CONTRACT_EXPORT_TEMPLATE=08_DATA/templates/Форма ответа_договор.xlsx

# Durable Kanban pipeline worker
# PARTSOPS_PIPELINE_WORKER_ID=worker-1
# PARTSOPS_START_PIPELINE_WORKER=1   # enable worker from ./start.sh
# PARTSOPS_PIPELINE_POLL_SECONDS=1

# ═══════════════════════════════════════════════════
# OBSIDIAN / VAULT (optional)
# ═══════════════════════════════════════════════════
# OBSIDIAN_VAULT_PATH=

# ═══════════════════════════════════════════════════
# FRONTEND (Vite — set in 06_UI/admin_cockpit/.env)
# ═══════════════════════════════════════════════════
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_PARTSOPS_API_TOKEN=
# VITE_PARTSOPS_TENANT_ID=default
