# PartsOps AI Manager — Environment Configuration
# Copy this to .env and fill in your keys.
# Only ONE provider is required; the system falls through the chain.

# ─── Primary: NVIDIA NIM (cloud, free-tier models) ───
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=google/gemma-4-31b-it

# ─── Local: LM Studio (free, no key needed) ───
# Start LM Studio with OpenAI-compatible server before running the app.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=llama-3.1-8b-instruct

# ─── Cloud Reserve: OpenRouter (100+ models, $0.05/1M tokens for free tier) ───
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─── App Settings ───
TESTING=0
LOG_LEVEL=INFO
