# Frontend Dockerfile - Multi-stage build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY 06_UI/admin_cockpit/package*.json ./06_UI/admin_cockpit/

# Install dependencies
RUN npm ci --prefix 06_UI/admin_cockpit

# Copy source code
COPY 06_UI/admin_cockpit/ ./06_UI/admin_cockpit/

# Build the application
RUN npm run build --prefix 06_UI/admin_cockpit

# Production stage
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/06_UI/admin_cockpit/dist /usr/share/nginx/html

# Copy nginx config
COPY 06_UI/admin_cockpit/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]