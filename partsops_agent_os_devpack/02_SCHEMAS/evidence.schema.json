{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "type",
    "source_ref",
    "created_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "quality_score": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "payload_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
