{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvoiceDraft",
  "type": "object",
  "required": [
    "invoice_draft_id",
    "request_id",
    "status",
    "admin_approved"
  ],
  "properties": {
    "invoice_draft_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft"
      ]
    },
    "admin_approved": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
