{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemEvent",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "source",
    "severity",
    "message"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
