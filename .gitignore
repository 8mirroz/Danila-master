# ==========================================
# Danila Master Unified GitIgnore Policy
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
env/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node.js / Frontend ---
node_modules/
dist/
build/
.vite/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
*.db.bak
webui.db
partsops-ai-manager/08_DATA/
partsops-ai-manager/database.db

# --- Environment & Secrets ---
.env
.env.*
!.env.example
!partsops-ai-manager/06_UI/admin_cockpit/.env.staging.example
*.pem
*.key

# --- Backups & Temporary Files ---
*.bak
*.bak2
*.backup
*.tmp
*~
*.swp
*.swo
*.log
*.pid
__TRASH__/

# --- OS Artifacts ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Icon?

# --- Browser & Automation Testing ---
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/
.browser-profile/

# --- Crawler & Scraping Runtime State ---
autodoc_*.png
autodoc_*.json
exist_*.png
exist_*.json
rossko_*.png
rossko_*.json
my-crawler/results/
my-crawler/screenshots/
my-crawler/storage/
my-crawler/articles.txt
my-crawler/*_debug.png
versions_screenshots/

# Crawler Implementation Whitelist (keep code versioned, ignore runtime output)
my-crawler/*
!my-crawler/Dockerfile
!my-crawler/README.md
!my-crawler/pyproject.toml
!my-crawler/requirements.txt
!my-crawler/uv.lock
!my-crawler/my_crawler/
!my-crawler/my_crawler/**
!my-crawler/tests/
!my-crawler/tests/**
my-crawler/**/__pycache__/
my-crawler/**/*.py[cod]
my-crawler/**/*.egg-info/

# --- Obsidian Sync & Agent Caches ---
DM obs/obsidian_sync.log
"DM obs/obsidian_sync.log"
.hermes/
partsops-ai-manager/.hermes/
.kilo/
